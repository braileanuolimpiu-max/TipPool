# Only for running TipPool on your own computer.
# On a hosted site you don't need this file: the hosting service generates the keys, and email, Claude,
# PayPal, the demo and the scheduler are set up on the website (Platform, at the top, for the person
# who runs the site). Anything saved there comes before what's written here.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app's webhook settings (needed when hosted)
PAYPAL_WEBHOOK_ID=

# --- AI ---
# mock = free built-in parser (no key) | claude = real Claude API
AI_MODE=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Django ---
# 1 = local development. Leave it out (or 0) in production: the app then refuses to start
# without DJANGO_SECRET_KEY, TIPPOOL_ENCRYPTION_KEY and DATABASE_URL.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Postgres in production, e.g. postgres://user:pass@host:5432/tippool
DATABASE_URL=
# Encrypts each business's PayPal secret. Make one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TIPPOOL_ENCRYPTION_KEY=
# Businesses without their own PayPal use the account above (sandbox demo). Must be 0 with live PayPal.
PAYPAL_PLATFORM_FALLBACK=

# --- Email (invites, password resets, alerts). Locally they print in the terminal. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TipPool <no-reply@example.com>

# --- "Try the demo" and sandbox_check ---
# Sandbox PERSONAL accounts the demo team is paid at, so demo payouts really arrive in the sandbox.
# Without them demo payouts go to name.demo@example.com and show as unclaimed.
MARIA_EMAIL=
JOHN_EMAIL=
LEA_EMAIL=
ALEX_EMAIL=
SAM_EMAIL=
# A sandbox buyer shown on demo tip pages, so visitors can pay a test tip
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# --- Hosting ---
# An outside scheduler (e.g. cron-job.org) calls /internal/tick/?key=CRON_SECRET every 10 minutes:
# automatic close-outs, demo clean-up, and it keeps a free server awake.
CRON_SECRET=
# Shown on the privacy and terms pages
CONTACT_EMAIL=
