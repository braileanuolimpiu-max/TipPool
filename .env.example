# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app's webhook settings (needed when hosted)
PAYPAL_WEBHOOK_ID=

# --- AI ---
# mock = free built-in parser (no key) | claude = real Claude API
AI_MODE=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Demo data (python manage.py seed_demo) ---
DEMO_USERNAME=manager
DEMO_PASSWORD=tippool-demo
# Name:role:sandbox_paypal_email, comma separated (roles: server, bartender, busser, host, runner, cook, dishwasher)
DEMO_STAFF=Maria:server:,John:server:,Lea:server:,Alex:bartender:,Sam:busser:

# --- Django ---
# 1 = local development. Leave it out (or 0) in production: the app then refuses to start
# without DJANGO_SECRET_KEY, TIPPOOL_ENCRYPTION_KEY and DATABASE_URL.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Postgres in production, e.g. postgres://user:pass@host:5432/tippool
DATABASE_URL=
# Encrypts each business's PayPal secret. Make one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TIPPOOL_ENCRYPTION_KEY=
# Businesses without their own PayPal use the account above (sandbox demo). Must be 0 with live PayPal.
PAYPAL_PLATFORM_FALLBACK=

# --- Email (invites, password resets, alerts). Locally they print in the terminal. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TipPool <no-reply@example.com>

# --- Only used by test_payout.py ---
MARIA_EMAIL=
